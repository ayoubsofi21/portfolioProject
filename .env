# EmailJS configuration (https://www.emailjs.com/)
# 1. Create an account at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> get Service ID
# 3. Create an Email Template with variables {{from_name}}, {{from_email}}, {{message}} -> get Template ID
# 4. In Account > API Keys -> get Public Key
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
